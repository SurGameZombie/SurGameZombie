{
  "permissions": {
    "additionalDirectories": [
      "C:\\ClaudeMCPsPlugingsSkillsETC"
    ],
    "allow": [
      "Bash(git add *)",
      "Bash(git checkout *)",
      "PowerShell(git add *)",
      "PowerShell(git checkout *)"
    ],
    "deny": [
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/*.md)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/.gitignore)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/.claude/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/skills/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/plugins/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/mcp/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/connectors/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/hooks/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/comandos/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/otros/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/comparativas/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/propio/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/investigacion/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/plantillas/**)",
      "Edit(//c/ClaudeMCPsPlugingsSkillsETC/proyectos/webpersonal/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-confirmacion.sh",
            "timeout": 10,
            "statusMessage": "¿Esto es un commit o un push?"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/consistencia.sh",
            "timeout": 120,
            "statusMessage": "Comparando los pares duplicados…",
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/navmesh-recordatorio.sh",
            "timeout": 15,
            "statusMessage": "¿Se tocó el NavMesh?"
          }
        ]
      }
    ]
  }
}
