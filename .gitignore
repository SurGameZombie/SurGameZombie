# Godot 4+
.godot/
/android/
*.tmp

# Exportaciones
/build/
*.exe
*.pck
*.zip

# Presets de exportación: guardan rutas locales y, si algún día firmamos builds,
# credenciales. No van al repo.
export_presets.cfg

# Reportes de gdUnit4. Los escribe el runner en cada corrida, numerados
# (report_1, report_2, ...), así que crecen sin límite y no le sirven a nadie
# más que a quien corrió los tests en su máquina.
/reports/

# Permisos y overrides personales de Claude Code. Guardan rutas absolutas del home
# de cada uno y la lista de comandos que cada máquina aceptó, así que son de la
# máquina y no del proyecto — al revés que .claude/settings.json, que sí va al repo
# porque define los hooks para los dos.
#
# Va acá y no alcanza con el gitignore global de una máquina: en la otra el archivo
# no está ignorado y un `git add` amplio se lo lleva.
.claude/settings.local.json

# Sistema
.DS_Store
Thumbs.db

# Editor
.vscode/
